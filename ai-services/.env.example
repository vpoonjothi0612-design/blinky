# =============================================================================
# AI Services - Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# CP PLUS IP Camera 1 (CAM-01) Configuration
# -----------------------------------------------------------------------------
CAMERA_1_IP=192.168.15.56
CAMERA_1_USERNAME=admin
CAMERA_1_PASSWORD=your_camera_1_password_here
CAMERA_1_RTSP_PORT=554
CAMERA_1_STREAM_SUBTYPE=0
CAMERA_1_CHANNEL=1
CAMERA_1_SCHEME=rtsps
CAMERA_1_RTSP_PATH=/video/live?channel=1&subtype=0&unicast=true&proto=Onvif

# CP PLUS 4MP main-stream target: up to 2688x1520 at 25/30 FPS.
# Keep subtype=0 for face recognition; subtype=1 is a preview/substream only.
# The pipeline starts H264-compatible streaming and may fall back to documented
# alternate RTSP scheme/path candidates. Verify codec with the live status output.
AI_PROCESS_INTERVAL_MS=33

# -----------------------------------------------------------------------------
# CP PLUS IP Camera 2 (CAM-02) Configuration
# -----------------------------------------------------------------------------
CAMERA_2_IP=192.168.15.57
CAMERA_2_USERNAME=admin
CAMERA_2_PASSWORD=your_camera_2_password_here
CAMERA_2_RTSP_PORT=554
CAMERA_2_STREAM_SUBTYPE=0
CAMERA_2_CHANNEL=1
CAMERA_2_SCHEME=rtsps
CAMERA_2_RTSP_PATH=/video/live?channel=1&subtype=0&unicast=true&proto=Onvif

# -----------------------------------------------------------------------------
# RTSP Stream & Network Resilience Settings
# -----------------------------------------------------------------------------
CAMERA_RTSP_TRANSPORT=tcp
CAMERA_CONNECT_TIMEOUT_SEC=5.0
CAMERA_READ_TIMEOUT_SEC=3.0
CAMERA_RECONNECT_ENABLED=true
CAMERA_RECONNECT_INITIAL_DELAY_SEC=1.0
CAMERA_RECONNECT_BACKOFF_FACTOR=2.0
CAMERA_RECONNECT_MAX_DELAY_SEC=30.0

# -----------------------------------------------------------------------------
# Face Recognition & Attendance Settings
# -----------------------------------------------------------------------------
BACKEND_API_URL=https://facetrack.gldatacenter.com/api
AI_INTERNAL_TOKEN=AI_SYSTEM_INTERNAL_TOKEN_V1
AI_LIVE_WORKER_ENABLED=true
ATTENDANCE_COOLDOWN_SEC=120.0
UNKNOWN_CAPTURE_COOLDOWN_SEC=15.0
CONFIRMATION_FRAMES=2
FACE_MIN_PX_CAM_01=56
FACE_MIN_PX_CAM_02=48
FACE_MAX_YAW_DEG=35
FACE_MIN_PITCH_DEG=-20
FACE_MAX_PITCH_DEG=25
FACE_EARLY_DECISION_SCORE=0.86
YOLO_MAX_DIM=960

# -----------------------------------------------------------------------------
# CP PLUS NVR Historical Recording Recovery
# -----------------------------------------------------------------------------
NVR_IP=192.168.15.55
NVR_PORT=554
NVR_USERNAME=admin
NVR_PASSWORD=your_nvr_password_here
# Physical recorder channel mapping verified on CP-UNR-4K4082-V4:
# CAM-01 (192.168.15.56 - OUT) is mapped to Channel 2
# CAM-02 (192.168.15.57 - IN) is mapped to Channel 1
NVR_CHANNEL_CAM01=2
NVR_CHANNEL_CAM02=1
NVR_PLAYBACK_SCHEME=rtsp
NVR_TIMEZONE=Asia/Kolkata
NVR_RECOVERY_INTERVAL_MINUTES=15
NVR_RECOVERY_LOOKBACK_HOURS=48
NVR_RECOVERY_MIN_GAP_SECONDS=60.0
NVR_RECOVERY_TIMEOUT_SEC=5.0

# Enable crossing review behavior and hide person body boxes in the live HUD.
FACE_CROSSING_MODE=true


