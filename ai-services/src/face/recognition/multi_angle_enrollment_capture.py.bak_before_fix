def get_next_available_index(enroll_dir: Path, emp_id: str) -> int:
    """Finds next index number for new photos so existing ones are never overwritten."""
    max_idx = 0
    pattern = re.compile(rf"{re.escape(emp_id)}_angle_(\d+)_", re.IGNORECASE)
    for p in enroll_dir.glob("*.jpg"):
        match = pattern.match(p.name)
        if match:
            idx = int(match.group(1))
            if idx > max_idx:
                max_idx = idx
    return max_idx + 1


