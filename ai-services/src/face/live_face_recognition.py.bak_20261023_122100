def main():
    parser = argparse.ArgumentParser(description="Live Face Recognition & Attendance Pipeline")
    parser.add_argument(
        "--camera",
        "-c",
        default=os.environ.get("CAMERA_ID") or os.environ.get("CAMERA_SOURCE") or os.environ.get("CAMERA_RTSP_URL") or os.environ.get("CAMERA_INDEX", "0"),
        help="Camera identifier: CAM-01, CAM-02, 0 (webcam), or RTSP URL (default: from .env or 0)",
    )
    args = parser.parse_args()
    cam_target = str(args.camera).strip()

    print("========================================")
    print("LIVE FACE RECOGNITION & ATTENDANCE PIPELINE")
    print("========================================")
    print(f"Target Reference  : {EMPLOYEE_ID}")
    print(f"Camera Source     : {cam_target}")
    print(f"Threshold         : {RECOGNITION_THRESHOLD:.2f}")
    print("Controls          : Press 'q' or ESC to exit")
    print("========================================\n")

    # 1. Verify and Load All Active Registered Embeddings
    active_employees: Dict[str, Dict[str, Any]] = load_all_active_embeddings()
    if not active_employees:
        print("[Notice] No active employees in registry, falling back to reference file...")
        if REFERENCE_EMBEDDING_PATH.exists():
            ref_raw = np.load(str(REFERENCE_EMBEDDING_PATH)).flatten()
            ref_norm = float(np.linalg.norm(ref_raw))
            if ref_norm > 0:
                ref_raw = ref_raw / ref_norm
            active_employees[EMPLOYEE_ID] = {
                "employeeId": EMPLOYEE_ID,
                "name": "sanjay",
                "embedding": ref_raw,
                "status": "active"
            }

    print(f"Loaded {len(active_employees)} active registered employee embedding(s):")
    for eid, edata in active_employees.items():
        print(f"  - {eid}: {edata.get('name', 'N/A')} (File: {edata.get('embeddingFile', 'N/A')})")
    print()

    # 2. Verify Models
    if not YUNET_MODEL_PATH.exists():
        print(f"Error: YuNet model not found: {YUNET_MODEL_PATH}")
        return
    if not ARCFACE_MODEL_PATH.exists():
        print(f"Error: ArcFace model not found: {ARCFACE_MODEL_PATH}")
        return

    # 3. Load ArcFace Model
    print("Loading ArcFace model (w600k_r50)...")
    arcface = get_model(str(ARCFACE_MODEL_PATH), providers=["CPUExecutionProvider"])
    arcface.prepare(ctx_id=0)
    print("ArcFace model loaded successfully.\n")

    # 4. Open Camera (CP PLUS Worker or Direct OpenCV)
    camera_worker: Optional[CameraWorker] = None
    cap: Optional[cv2.VideoCapture] = None
    init_frame = None

    target_upper = cam_target.upper()
    if target_upper in ("BOTH", "ALL"):
        try:
            from dual_camera_live_face_recognition import run_dual_camera_recognition
            run_dual_camera_recognition()
            return
        except ImportError:
            from src.face.dual_camera_live_face_recognition import run_dual_camera_recognition
            run_dual_camera_recognition()
            return

    if target_upper in ("CAM-01", "CAM-02", "1", "2"):
        try:
            cfg = get_camera_config(target_upper)
            print(f"Opening CP PLUS camera {cfg.camera_id}: {cfg.sanitized_url}...")
            camera_worker = CameraWorker(config=cfg, auto_start=True)
        except Exception as e:
            print(f"Error loading camera config: {e}")
            return
    elif cam_target.startswith("rtsp://") or cam_target.startswith("rtsps://"):
        print(f"Opening RTSP camera stream: {sanitize_rtsp_url(cam_target)}...")
        camera_worker = CameraWorker(config=cam_target, camera_id="RTSP-CAM", auto_start=True)
    else:
        # Local device index (webcam)
        cam_idx = int(cam_target) if cam_target.isdigit() else 0
        print(f"Opening local webcam index {cam_idx}...")
        cap = cv2.VideoCapture(cam_idx, cv2.CAP_DSHOW)
        if not cap.isOpened():
            cap = cv2.VideoCapture(cam_idx)
        if not cap.isOpened():
            print(f"Error: Could not open local camera {cam_idx}.")
            return

    # Wait for initial frame
    if camera_worker is not None:
        print("Waiting for camera connection and first frame...")
        wait_start = time.time()
        while time.time() - wait_start < 10.0:
            has_f, f, _, _ = camera_worker.get_latest_frame()
            if has_f and f is not None:
                init_frame = f
                break
            time.sleep(0.1)

        if init_frame is None:
            status = camera_worker.get_status()
            print(f"Error: Could not read frame from camera worker ({status['state']}).")
            if status.get("last_error"):
                print(f"Diagnostic error: {status['last_error']}")
            camera_worker.stop()
            return
    else:
        ret, init_frame = cap.read()
        if not ret or init_frame is None:
            print("Error: Could not read frame from local camera.")
            if cap:
                cap.release()
            return

    cam_h, cam_w = init_frame.shape[:2]
    print(f"Camera opened     : OK ({cam_w} x {cam_h})")

    # 5. Initialize YuNet Detector
    detector = cv2.FaceDetectorYN.create(
        str(YUNET_MODEL_PATH),
        "",
        (cam_w, cam_h),
        SCORE_THRESHOLD,
        NMS_THRESHOLD,
        TOP_K,
    )
    detector.setInputSize((cam_w, cam_h))
    print("YuNet detector    : OK (score_threshold = 0.5)")
    print("\nStarting recognition stream...\n")

    liveness_tracker = TemporalLivenessTracker()

    # Session Metrics & Throttle Tracking
    total_frames = 0
    face_detected_frames = 0
    liveness_passed_count = 0
    recognition_attempts = 0
    similarity_scores = []

    last_similarity: Optional[float] = None
    last_candidate_id: Optional[str] = None
    last_candidate_name: Optional[str] = None
    current_state = "WAITING"
    liveness_status = "WAITING"
    attendance_status = "PENDING"

    last_attendance_sent: Dict[str, float] = {}
    last_unknown_sent: float = 0.0
    recent_unknown_captures: List[Dict[str, Any]] = []
    unknown_detection_count: int = 0

    try:
        while True:
            if camera_worker is not None:
                has_frame, frame, ts, f_idx = camera_worker.get_latest_frame()
                if not has_frame or frame is None:
                    time.sleep(0.01)
                    continue
            else:
                ret, frame = cap.read()
                if not ret or frame is None:
                    continue

            total_frames += 1
            h, w = frame.shape[:2]

            # Fast detection downscale (target width 640 for rapid real-time tracking)
            target_w = 640
            if w > target_w:
                det_scale = target_w / float(w)
                det_w = target_w
                det_h = int(h * det_scale)
                det_frame = cv2.resize(frame, (det_w, det_h), interpolation=cv2.INTER_LINEAR)
            else:
                det_scale = 1.0
                det_w, det_h = w, h
                det_frame = frame

            if (det_w, det_h) != (cam_w, cam_h):
                cam_w, cam_h = det_w, det_h
                detector.setInputSize((cam_w, cam_h))

            # Fast face detection
            _, raw_faces = detector.detect(det_frame)
            face_info = {"detected": False}
            face_crop = None
            aligned_face = None

            if raw_faces is None or len(raw_faces) == 0:
                current_state = "WAITING"
                liveness_status = "WAITING"
                liveness_tracker.reset()
                last_similarity = None
                last_candidate_id = None
                last_candidate_name = None
            else:
                face_detected_frames += 1
                faces = raw_faces.copy()
                if det_scale != 1.0:
                    inv_scale = 1.0 / det_scale
                    faces[:, 0:4] *= inv_scale
                    faces[:, 4:14] *= inv_scale

                face = faces[0]
                bx, by, bw, bh = map(int, face[0:4])
                landmarks = face[4:14].reshape(5, 2)

                # Safe face crop with padding for unknown snapshots and telemetry
                pad = 20
                cy1, cy2 = max(0, by - pad), min(h, by + bh + pad)
                cx1, cx2 = max(0, bx - pad), min(w, bx + bw + pad)
                face_crop = frame[cy1:cy2, cx1:cx2].copy()
                if face_crop.size == 0:
                    face_crop = frame[max(0, by):min(h, by + bh), max(0, bx):min(w, bx + bw)].copy()
                if face_crop.size == 0:
                    face_crop = frame.copy()

                face_info = {
                    "detected": True,
                    "bbox": (bx, by, bw, bh),
                    "landmarks": landmarks,
                }

                gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
                is_live, liveness_state_name, motion = liveness_tracker.update(
                    (bx, by, bw, bh), landmarks, gray
                )
                liveness_status = liveness_state_name

                if not is_live:
                    current_state = "CHECKING_LIVENESS"
                    last_similarity = None
                else:
                    liveness_passed_count += 1

                    # Canonical ArcFace 112x112 similarity alignment directly on frame (<1ms, no blocking)
                    if face_align is not None:
                        aligned_face = face_align.norm_crop(frame, landmark=landmarks, image_size=112)
                    else:
                        transform, _ = cv2.estimateAffinePartial2D(
                            landmarks.astype(np.float32),
                            REFERENCE_POINTS,
                            method=cv2.LMEDS,
                        )
                        aligned_face = cv2.warpAffine(frame, transform, (112, 112)) if transform is not None else None

                    if aligned_face is not None:
                        # ArcFace 512-D embedding extraction
                        raw_emb = arcface.get_feat(aligned_face).flatten()
                        raw_norm = float(np.linalg.norm(raw_emb))

                        if raw_norm > 0:
                            live_emb = (raw_emb / raw_norm).flatten()
                            live_norm = float(np.linalg.norm(live_emb))

                            # 5. Cosine similarity against ALL active registered employees
                            best_cand_id = None
                            best_cand_name = None
                            best_similarity = -1.0

                            for emp_id, emp_record in active_employees.items():
                                sim = float(np.dot(live_emb, emp_record["embedding"]))
                                if sim > best_similarity:
                                    best_similarity = sim
                                    best_cand_id = emp_id
                                    best_cand_name = emp_record.get("name", emp_id)

                            recognition_attempts += 1
                            similarity_scores.append(best_similarity)
                            last_similarity = best_similarity
                            last_candidate_id = best_cand_id
                            last_candidate_name = best_cand_name

                            now_time = time.time()

                            # ----------------------------------------------------
                            # RECOGNITION DECISION & ATTENDANCE / UNKNOWN RULE
                            # ----------------------------------------------------
                            if best_similarity >= RECOGNITION_THRESHOLD and best_cand_id:
                                current_state = f"RECOGNIZED: {best_cand_id}"

                                # Trigger Attendance API (60-sec cooldown per employee)
                                if (now_time - last_attendance_sent.get(best_cand_id, 0)) > 60:
                                    last_attendance_sent[best_cand_id] = now_time
                                    try:
                                        payload = {
                                            "employeeId": best_cand_id,
                                            "status": "PRESENT",
                                            "eventType": "IN",
                                            "similarity": round(float(best_similarity), 4),
                                            "eventId": str(uuid.uuid4()),
                                            "source": "AI_CAMERA",
                                        }
                                        resp = requests.post(
                                            f"{BACKEND_API_URL}/attendance",
                                            json=payload,
                                            headers=INTERNAL_AUTH_HEADER,
                                            timeout=3.0,
                                        )
                                        if resp.status_code in (200, 201):
                                            attendance_status = f"PRESENT ({best_cand_id})"
                                            print("\n=======================================================")
                                            print(f"[ATTENDANCE SUCCESS] Marked PRESENT for {best_cand_id} ({best_cand_name})")
                                            print(f"  Similarity: {best_similarity:.4f} (>= {RECOGNITION_THRESHOLD:.2f})")
                                            print(f"  Timestamp : {time.strftime('%Y-%m-%d %H:%M:%S')}")
                                            print("=======================================================\n")
                                        else:
                                            attendance_status = "PRESENT (Recorded)"
                                            print(f"[Attendance Notice] {resp.status_code}: {resp.json().get('message', '')}")
                                    except Exception as ex:
                                        print(f"[Attendance Error] Failed to connect to backend: {ex}")
                                else:
                                    attendance_status = f"PRESENT ({best_cand_id})"

                            else:
                                current_state = "UNKNOWN FACE"
                                unknown_detection_count += 1

                                # Trigger Auto-Capture Unknown Face API (15-sec per-person cooldown by embedding similarity)
                                is_on_cooldown = False
                                for item in recent_unknown_captures:
                                    sim = float(np.dot(live_emb, item["embedding"]))
                                    if sim >= 0.50:  # Same unknown person
                                        if (now_time - item["time"]) < 15.0:
                                            is_on_cooldown = True
                                            break

                                if not is_on_cooldown:
                                    last_unknown_sent = now_time
                                    # Update or add to recent_unknown_captures
                                    matched_item = None
                                    for item in recent_unknown_captures:
                                        if float(np.dot(live_emb, item["embedding"])) >= 0.50:
                                            matched_item = item
                                            break
                                    if matched_item is not None:
                                        matched_item["time"] = now_time
                                        matched_item["embedding"] = live_emb
                                    else:
                                        recent_unknown_captures.append({"embedding": live_emb, "time": now_time})

                                    # Prune entries older than 60s
                                    recent_unknown_captures = [it for it in recent_unknown_captures if (now_time - it["time"]) <= 60.0]

                                    try:
                                        unknown_dir = Path(BASE_DIR) / "data" / "unknown"
                                        unknown_dir.mkdir(parents=True, exist_ok=True)
                                        fname = f"unknown_{int(now_time * 1000)}.jpg"
                                        fpath = unknown_dir / fname
                                        crop_to_save = face_crop if (face_crop is not None and face_crop.size > 0) else aligned_face
                                        if crop_to_save is not None and crop_to_save.size > 0:
                                            cv2.imwrite(str(fpath), crop_to_save)

                                        payload = {
                                            "image": fname,
                                            "visitCount": unknown_detection_count,
                                            "embedding": live_emb.tolist(),
                                            "metadata": {
                                                "camera": "CAM-01 (IN)",
                                                "location": "Main Entrance Gate",
                                            }
                                        }
                                        resp = requests.post(
                                            f"{BACKEND_API_URL}/face-enrollments/capture-unknown",
                                            json=payload,
                                            headers=INTERNAL_AUTH_HEADER,
                                            timeout=2.0,
                                        )
                                        if resp.status_code in (200, 201):
                                            print("\n-------------------------------------------------------")
                                            if unknown_detection_count > 3:
                                                print(f"🚨 [ALERT: UNKNOWN DETECTED > 3 TIMES] Repeated visitor #{unknown_detection_count}")
                                            else:
                                                print(f"[UNKNOWN CAPTURED] Auto-captured unknown face -> Unknown Faces dashboard")
                                            print(f"  Photo Saved  : {fname}")
                                            print(f"  Total Seen   : {unknown_detection_count} time(s)")
                                            print(f"  Top Match    : {best_cand_id} ({best_similarity:.4f} < {RECOGNITION_THRESHOLD:.2f})")
                                            print(f"  Timestamp    : {time.strftime('%Y-%m-%d %H:%M:%S')}")
                                            print("-------------------------------------------------------\n")
                                        else:
                                            print(f"[Unknown Notice] {resp.status_code}: {resp.text}")
                                    except Exception as ex:
                                        print(f"[Unknown Error] Failed to send unknown face: {ex}")

                            # Debug telemetry output for recognition attempt
                            print(f"Recognition attempt #{recognition_attempts}")
                            print("-------------------------------")
                            print(f"Status                  : {current_state}")
                            if current_state == "UNKNOWN FACE":
                                print(f"Unknown Count           : {unknown_detection_count}{' (ALERT: > 3 times)' if unknown_detection_count > 3 else ''}")
                            print(f"Best Candidate          : {best_cand_id} ({best_cand_name})")
                            print(f"Cosine similarity       : {best_similarity:.6f} (Threshold: {RECOGNITION_THRESHOLD:.2f})")
                            print(f"Attendance Status       : {attendance_status}")
                            if face_crop is not None and face_crop.size > 0:
                                print(f"Face crop size          : {face_crop.shape[1]} x {face_crop.shape[0]}")
                            if aligned_face is not None and aligned_face.size > 0:
                                print(f"Aligned face size       : {aligned_face.shape[1]} x {aligned_face.shape[0]}")
                            print("-------------------------------\n")

            # Render display HUD
            display_frame = draw_hud(
                frame,
                face_info,
                current_state,
                liveness_status,
                last_similarity,
                last_candidate_id,
                last_candidate_name,
                attendance_status,
                total_frames,
                unknown_count=unknown_detection_count,
            )

            cv2.imshow("Live Face Recognition & Attendance Pipeline", display_frame)

            key = cv2.waitKey(1) & 0xFF
            if key == ord("q") or key == 27:
                break

    finally:
        if camera_worker is not None:
            camera_worker.stop()
        if cap is not None:
            cap.release()
        cv2.destroyAllWindows()

        avg_similarity = float(np.mean(similarity_scores)) if similarity_scores else 0.0

        print("\n================================")
        print("LIVE FACE RECOGNITION SUMMARY")
        print("================================")
        print(f"Frames processed     : {total_frames}")
        print(f"Faces detected       : {face_detected_frames}")
        print(f"Liveness passed      : {liveness_passed_count}")
        print(f"Recognition attempts : {recognition_attempts}")
        if similarity_scores:
            print(f"Average similarity   : {avg_similarity:.6f}")
        else:
            print("Average similarity   : N/A")
        print(f"Final state          : {current_state}")
        print(f"Final attendance     : {attendance_status}")
        print("================================")


if __name__ == "__main__":
    main()
