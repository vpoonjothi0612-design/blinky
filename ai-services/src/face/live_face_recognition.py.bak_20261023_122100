def draw_hud(
    frame: np.ndarray,
    face_info: dict,
    state: str,
    liveness_status: str,
    similarity: Optional[float],
    candidate_id: Optional[str],
    candidate_name: Optional[str],
    attendance_status: str,
    frame_idx: int,
    unknown_count: int = 0,
) -> np.ndarray:
    """Renders informative status HUD on top of the live frame."""
    canvas = frame.copy()

    # Determine state color
    if state.startswith("RECOGNIZED"):
        color = (0, 220, 0)        # Green
    elif state == "UNKNOWN FACE":
        color = (0, 0, 255)        # Red
    elif state == "RECOGNIZING":
        color = (0, 200, 255)      # Yellow / Amber
    elif state == "CHECKING_LIVENESS":
        color = (255, 180, 0)      # Cyan / Light Blue
    elif state == "NO_DECISION":
        color = (0, 165, 255)      # Orange
    else:
        color = (180, 180, 180)    # Gray

    # Draw face box and landmarks
    if face_info.get("detected"):
        bx, by, bw, bh = face_info["bbox"]
        cv2.rectangle(canvas, (bx, by), (bx + bw, by + bh), color, 2)

        landmarks = face_info["landmarks"]
        for pt in landmarks:
            cv2.circle(canvas, (int(pt[0]), int(pt[1])), 3, (0, 255, 255), -1)

        tag = state
        if candidate_id and similarity is not None and similarity >= RECOGNITION_THRESHOLD:
            tag = f"{candidate_id} - PRESENT ({similarity:.2f})"
        elif similarity is not None and similarity < RECOGNITION_THRESHOLD:
            tag = f"UNKNOWN ({similarity:.2f})"
            if unknown_count > 3:
                tag += f" [>3x DETECTED!]"
        cv2.putText(canvas, tag, (bx, max(22, by - 8)), cv2.FONT_HERSHEY_SIMPLEX, 0.55, color, 2)

    # Info banner panel
    panel_h = 230 if unknown_count > 3 else 200
    cv2.rectangle(canvas, (10, 10), (480, panel_h), (25, 25, 25), -1)
    cv2.rectangle(canvas, (10, 10), (480, panel_h), (80, 80, 80), 1)

    cv2.putText(canvas, f"STATE     : {state}", (25, 38), cv2.FONT_HERSHEY_SIMPLEX, 0.65, color, 2)
    cv2.putText(canvas, f"LIVENESS  : {liveness_status}", (25, 68), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (220, 220, 220), 1)

    cand_disp = f"{candidate_id or 'None'}"
    if candidate_name:
        cand_disp += f" ({candidate_name})"
    cv2.putText(canvas, f"MATCH     : {cand_disp}", (25, 98), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255) if candidate_id else (180, 180, 180), 1)

    sim_str = f"{similarity:.4f}" if similarity is not None else "---"
    cv2.putText(canvas, f"SIMILARITY: {sim_str} (Threshold: {RECOGNITION_THRESHOLD:.2f})", (25, 128), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 255) if similarity is not None else (180, 180, 180), 1)

    att_color = (0, 220, 0) if "PRESENT" in attendance_status else (180, 180, 180)
    cv2.putText(canvas, f"ATTENDANCE: {attendance_status}", (25, 158), cv2.FONT_HERSHEY_SIMPLEX, 0.55, att_color, 2 if "PRESENT" in attendance_status else 1)
    cv2.putText(canvas, f"Frame: {frame_idx}", (25, 188), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (160, 160, 160), 1)

    if unknown_count > 3:
        cv2.putText(canvas, f"ALERT: UNKNOWN DETECTED >3x ({unknown_count} times)", (25, 218), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 0, 255), 2)

    return canvas


def draw_multi_person_hud(
    frame: np.ndarray,
    tracks_info: List[Dict[str, Any]],
    camera_id: str,
    event_type: str,
    stats: Dict[str, Any],
    fps: float = 0.0,
    outbox_depth: int = 0,
) -> np.ndarray:
    """Renders bounding boxes and labels for multiple tracked people, plus camera telemetry banner."""
    canvas = frame.copy()
    h, w = canvas.shape[:2]

    # 1. Draw each tracked face
    for item in tracks_info:
        bbox = item.get("bbox", (0, 0, 0, 0))
        bx, by, bw, bh = bbox
        if bw <= 0 or bh <= 0:
            continue

        status = item.get("status", "WAITING")
        emp_id = item.get("employee_id")
        emp_name = item.get("name")
        sim = item.get("similarity")
        tid = item.get("track_id", 0)
        att_state = item.get("attendance_state", "")

        # Color coding
        if status.startswith("RECOGNIZED"):
            color = (0, 220, 0)        # Green
        elif "UNKNOWN" in status:
            color = (0, 0, 255)        # Red
        elif "AMBIGUOUS" in status or "UNCERTAIN" in status:
            color = (0, 165, 255)      # Orange
        elif "CHECKING" in status or "VERIFYING" in status:
            color = (255, 180, 0)      # Cyan
        elif "LOW_QUALITY" in status or "PARTIAL" in status:
            color = (140, 140, 140)    # Gray
        else:
            color = (200, 200, 200)

        # Draw bbox
        cv2.rectangle(canvas, (bx, by), (bx + bw, by + bh), color, 2)

        # Landmarks if available
        landmarks = item.get("landmarks")
        if landmarks is not None:
            for pt in landmarks:
                cv2.circle(canvas, (int(pt[0]), int(pt[1])), 2, (0, 255, 255), -1)

        # Label tag above bounding box
        if status.startswith("RECOGNIZED") and emp_id:
            label = f"#{tid} {emp_id}"
            if emp_name and emp_name != emp_id:
                label += f" ({emp_name})"
            m_view = item.get("matched_view")
            if m_view:
                label += f" [{m_view}]"
            if sim is not None:
                label += f" [{sim:.2f}]"
            if "Recorded" in att_state:
                label += f" - {event_type} REC"
            elif "Cooldown" in att_state:
                label += " [CD]"
        elif "UNKNOWN" in status:
            sim_str = f" [{sim:.2f}]" if sim is not None else ""
            label = f"#{tid} UNKNOWN{sim_str}"
        elif "AMBIGUOUS" in status:
            label = f"#{tid} AMBIGUOUS"
        elif "CHECKING" in status:
            label = f"#{tid} LIVENESS..."
        elif "LOW_QUALITY" in status:
            label = f"#{tid} LOW QUALITY"
        else:
            label = f"#{tid} {status}"

        # Draw label background for crisp legibility
        (tw, th), _ = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.5, 1)
        tag_y1 = max(0, by - th - 8)
        tag_y2 = max(th + 8, by)
        cv2.rectangle(canvas, (bx, tag_y1), (bx + tw + 6, tag_y2), (20, 20, 20), -1)
        cv2.rectangle(canvas, (bx, tag_y1), (bx + tw + 6, tag_y2), color, 1)
        cv2.putText(canvas, label, (bx + 3, tag_y2 - 4), cv2.FONT_HERSHEY_SIMPLEX, 0.48, (255, 255, 255), 1)

    # 2. Top Telemetry Banner
    banner_h = 60
    cv2.rectangle(canvas, (0, 0), (w, banner_h), (20, 20, 20), -1)
    cv2.line(canvas, (0, banner_h), (w, banner_h), (60, 60, 60), 1)

    # Camera Role & Status
    banner_color = (0, 255, 0) if event_type == "IN" else (0, 165, 255)
    cv2.putText(canvas, f"{camera_id} [{event_type}]", (12, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.65, banner_color, 2)

    conn_state = stats.get("connection_status", "CONNECTED")
    conn_color = (0, 220, 0) if conn_state == "CONNECTED" else (0, 165, 255)
    cv2.putText(canvas, f"{conn_state}", (140, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.5, conn_color, 1)

    fps_str = f"FPS: {fps:4.1f}"
    lat_str = f"Lat: {stats.get('avg_latency_ms', 0):.0f}ms"
    cv2.putText(canvas, f"{fps_str} | {lat_str}", (260, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (200, 200, 200), 1)

    # Telemetry Counters line 2
    active_faces = len(tracks_info)
    rec_count = stats.get("registered_identified", 0)
    unk_tracks = stats.get("unknown_tracks", 0)
    att_events = stats.get("attendance_recorded", 0)
    dup_prev = stats.get("duplicates_prevented", 0)

    summary_text = (
        f"Faces: {active_faces} | Rec: {rec_count} | Unk Tracks: {unk_tracks} | "
        f"Events: {att_events} | CD Blk: {dup_prev} | Outbox: {outbox_depth}"
    )
    cv2.putText(canvas, summary_text, (12, 48), cv2.FONT_HERSHEY_SIMPLEX, 0.48, (220, 220, 220), 1)

    return canvas



