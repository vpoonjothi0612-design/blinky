# STAGE 2: Temporal Liveness Tracker
# -----------------------------------

class TemporalLivenessTracker:
    """Tracks consecutive frame temporal metrics to verify live human presence."""

    def __init__(self, min_frames: int = 3):
        self.min_frames = min_frames
        self.history = deque(maxlen=HISTORY_WINDOW)
        self.consecutive_live_frames = 0
        self.is_live = False
        self.live_hold_frames = 0

    def reset(self):
        self.history.clear()
        self.consecutive_live_frames = 0
        self.is_live = False
        self.live_hold_frames = 0

    def update(self, face_bbox: tuple, landmarks: np.ndarray, gray: np.ndarray) -> tuple[bool, str, float]:
        bx, by, bw, bh = face_bbox
        left_eye = landmarks[0]
        right_eye = landmarks[1]
        nose = landmarks[2]

        centroid = np.array([bx + bw / 2.0, by + bh / 2.0], dtype=np.float32)
        left_eye_to_nose = np.linalg.norm(left_eye - nose)
        right_eye_to_nose = np.linalg.norm(right_eye - nose)
        geom_ratio = float(left_eye_to_nose / (right_eye_to_nose + 1e-6))

        left_intensity = self._eye_intensity(gray, left_eye)
        right_intensity = self._eye_intensity(gray, right_eye)

        current_frame_data = {
            "centroid": centroid,
            "geom_ratio": geom_ratio,
            "left_eye": left_intensity,
            "right_eye": right_intensity,
            "time": time.time(),
        }
        self.history.append(current_frame_data)

        if len(self.history) < self.min_frames:
            # Immediate responsive validation for natural human face geometry
            if bw >= 50 and bh >= 50 and 0.6 <= (bw / float(bh)) <= 1.5:
                self.is_live = True
                self.live_hold_frames = 0
                return True, "LIVE", 0.05
            return False, "CHECKING_LIVENESS", 0.0

        # Compute Metrics across the historical window
        centroids = np.array([f["centroid"] for f in self.history])
        displacements = np.linalg.norm(np.diff(centroids, axis=0), axis=1)
        mean_displacement = float(np.mean(displacements))
        face_diag = np.sqrt(bw**2 + bh**2) + 1e-6
        motion_score = float(mean_displacement / face_diag)

        ratios = [f["geom_ratio"] for f in self.history]
        ratio_variance = float(np.var(ratios))

        left_eyes = [f["left_eye"] for f in self.history]
        right_eyes = [f["right_eye"] for f in self.history]
        eye_variance = float(np.var(left_eyes) + np.var(right_eyes))

        # Decision Logic:
        has_natural_micro_motion = (MIN_MOTION_THRESHOLD <= motion_score <= MAX_MOTION_THRESHOLD)
        has_3d_rotation = (ratio_variance >= MIN_RATIO_VARIANCE)
        has_eye_action = (eye_variance >= MIN_EYE_VARIANCE)

        # Natural live motion confirmed
        if (has_natural_micro_motion and (has_3d_rotation or has_eye_action)) or (has_3d_rotation and has_eye_action):
            self.consecutive_live_frames += 1
            if self.consecutive_live_frames >= 2:
                self.is_live = True
                self.live_hold_frames = 0
                return True, "LIVE", motion_score
            return False, "CHECKING_LIVENESS", motion_score
        elif has_natural_micro_motion and self.is_live:
            # Subtle ongoing live motion maintains confirmed LIVE status
            self.live_hold_frames = 0
            return True, "LIVE", motion_score

        # If already confirmed LIVE, hold through subtle natural pauses (up to 20 frames)
        if self.is_live and self.live_hold_frames < 20:
            self.live_hold_frames += 1
            return True, "LIVE", motion_score

        # Rigid photo spoof detection
        self.consecutive_live_frames = 0
        self.is_live = False
        self.live_hold_frames = 0
        if len(self.history) >= HISTORY_WINDOW and (motion_score < (MIN_MOTION_THRESHOLD * 0.4) or (not has_3d_rotation and not has_eye_action)):
            return False, "SPOOF / LIVENESS FAILED", motion_score
        return False, "SPOOF / STATIC PHOTO", motion_score

    def _eye_intensity(self, gray: np.ndarray, pt: np.ndarray) -> float:
        x, y = int(pt[0]), int(pt[1])
        h, w = gray.shape[:2]
        r = 8
        patch = gray[max(0, y - r):min(h, y + r), max(0, x - r):min(w, x + r)]
        return float(patch.mean()) if patch.size > 0 else 0.0


